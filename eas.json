{
  "cli": {
    "version": ">= 16.13.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleRelease"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleRelease"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "gradleCommand": ":app:bundleRelease"
      },
      "channel": "production"
    },
    "bn": {
      "extends": "production",
      "env": {
        "APP_LANG": "bn",
        "APP_ENV": "production"
      },
      "channel": "bn",
      "android": {
        "buildType": "apk"
      }
    },
    "or": {
      "extends": "production",
      "env": {
        "APP_LANG": "or",
        "APP_ENV": "production"
      },
      "channel": "or",
      "android": {
        "buildType": "apk"
      }
    },
    "hi": {
      "extends": "production",
      "env": {
        "APP_LANG": "hi",
        "APP_ENV": "production"
      },
      "channel": "hi",
      "android": {
        "buildType": "apk"
      }
    },
    "as": {
      "extends": "production",
      "env": {
        "APP_LANG": "as",
        "APP_ENV": "production"
      },
      "channel": "as",
      "android": {
        "buildType": "apk"
      }
    },
    "gu": {
      "extends": "production",
      "env": {
        "APP_LANG": "gu",
        "APP_ENV": "production"
      },
      "channel": "gu",
      "android": {
        "buildType": "apk"
      }
    },
    "ne": {
      "extends": "production",
      "env": {
        "APP_LANG": "ne",
        "APP_ENV": "production"
      },
      "channel": "ne",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}