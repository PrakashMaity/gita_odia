{
  "cli": {
    "version": ">= 16.13.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleRelease"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleRelease"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "gradleCommand": ":app:bundleRelease"
      },
      "channel": "production"
    },
    "bn-apk": {
      "extends": "production",
      "env": {
        "APP_LANG": "bn",
        "APP_ENV": "production"
      },
      "channel": "bn-production",
      "android": {
        "buildType": "apk"
      }
    },
